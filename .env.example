# shogi_app 環境設定テンプレート
# このファイルをコピーして .env を作成し、実際の値を入力してください
# .env は .gitignore に追加済み（Git から除外）

# ===== Game 設定 =====
GAME_DIFFICULTY_PRESET=normal
INITIAL_PLAYER_LEVEL=1
MAX_SAVED_GAMES=100

# ===== SharedPreferences 設定 =====
# 将棋記録保存用キー名前空間
GAME_SAVE_KEY_PREFIX=app_shogi_game_

# ===== Sentry 設定（エラートラッキング） =====
SENTRY_DSN=https://your-sentry-key@sentry.io/your-project-id
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0
# 本番環境では SENTRY_TRACES_SAMPLE_RATE=0.1 推奨

# ===== Google Analytics（オプション） =====
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# ===== デバッグ設定 =====
DEBUG_MODE=true
ENABLE_VERBOSE_LOGGING=false

# ===== ビルド設定 =====
BUILD_FLAVOR=dev
BUILD_TIMESTAMP=
